# ─── Wallet ───────────────────────────────────────────────────────────────────
PRIVATE_KEY=

# ─── Polymarket API ───────────────────────────────────────────────────────────
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# ─── Telegram Bot (để nhận price alerts) ─────────────────────────────────────
# Hướng dẫn:
#   1. Nhắn tin cho @BotFather trên Telegram → /newbot → lấy BOT_TOKEN
#   2. Nhắn tin cho bot của mày bất kỳ nội dung gì
#   3. Lấy CHAT_ID bằng lệnh:
#      curl https://api.telegram.org/bot<BOT_TOKEN>/getUpdates
#      → tìm "chat":{"id": <số này là CHAT_ID>}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
